<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="FlorianMezzo.Pages.TempletePage">
    <ScrollView>
        <Grid
            BackgroundColor="{StaticResource Tertiary}">
            <!-- Main content -->
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>


            <VerticalStackLayout
            Padding="0, 0, 0, 30"
            Spacing="25"
            Grid.Row="0"
            BackgroundColor="Black">

                <Border 
    x:Name="header"
    Margin="0"
    Padding="0">
                    <!-- Main Navigation Bar -->
                    <ScrollView
        Orientation="Horizontal"
        HorizontalOptions="FillAndExpand">
                        <Border
            x:Name="navBar"
            BackgroundColor="{StaticResource Tertiary}"
            Padding="0,20,0,20"
            HorizontalOptions="FillAndExpand">
                            <StackLayout Orientation="Horizontal" Spacing="40" HorizontalOptions="Center">
                                <Label
                    Text="Home"
                    Style="{StaticResource Headline}"
                    TextColor="{StaticResource PrimaryDark}"
                    VerticalOptions="Start"
                    FontSize="44"
                    SemanticProperties.HeadingLevel="Level2"
                    >
                                    <Label.GestureRecognizers>
                                        <TapGestureRecognizer
                            NumberOfTapsRequired="1"
                            Tapped="redirectToMain" />
                                    </Label.GestureRecognizers>
                                </Label>
                                <Button
                    x:Name="CompatibilityNav"
                    Text="Compatibility Tool"
                    TextColor="{StaticResource Primary}"
                    SemanticProperties.Hint="Redirects User to Tile Tester Page"
                    Clicked="redirectToCompatibility"
                    WidthRequest="270"
                    MaximumWidthRequest="1000" />
                                <Button
                    x:Name="healthCheckNav"
                    Text="Health Check" 
                    TextColor="{StaticResource Primary}"
                    SemanticProperties.Hint="Redirects User to Health Check Page"
                    Clicked="redirectToHealthCheck"
                    WidthRequest="270"
                    MaximumWidthRequest="1000" />
                                <Button
                    x:Name="mezzoAnalysisNav"
                    Text="Mezzo Analysis" 
                    TextColor="{StaticResource Primary}"
                    SemanticProperties.Hint="Redirects User to Mezzo Analysis Page"
                    Clicked="redirectToMezzoAnalysis"
                    WidthRequest="270"
                    MaximumWidthRequest="1000" />
                                <Button
                    x:Name="more3AMNav"
                    Text="More 3AM" 
                    TextColor="{StaticResource Primary}"
                    SemanticProperties.Hint="Redirects User to More 3AM Page"
                    Clicked="redirectToMore3AM"
                    WidthRequest="270"
                    MaximumWidthRequest="1000" />
                            </StackLayout>
                        </Border>
                    </ScrollView>
                </Border>


                <VerticalStackLayout
                    x:Name="content"
                    MaximumWidthRequest="600"
                    Spacing="30">

                    <Label
                    Text="This Page is under construction"
                    Style="{StaticResource SubHeadline}"
                    VerticalOptions="Start"
                    FontSize="44"
                    SemanticProperties.HeadingLevel="Level2"/>

                </VerticalStackLayout>
            </VerticalStackLayout>

            <!-- Footer -->
			<Border
                x:Name="footer"
                Grid.Row="1"
                Padding="0,20"
                BackgroundColor="Transparent">
				<Grid HorizontalOptions="FillAndExpand" VerticalOptions="End">
					<Grid.ColumnDefinitions>
						<ColumnDefinition Width="Auto" />
						<ColumnDefinition Width="*" />
						<ColumnDefinition Width="Auto" />
					</Grid.ColumnDefinitions>
					<Label Grid.Column="0"></Label>
					<Label Grid.Column="1"></Label>
					<Image
                        Aspect="AspectFit"
						Grid.Column="2"
                        HeightRequest="80"
                        HorizontalOptions="End"
                        SemanticProperties.Description="3AM Logo"
                        Source="i3am_gold.png"
                        VerticalOptions="Center" />
				</Grid>
			</Border>
		</Grid>
	</ScrollView>
</ContentPage>
<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="FlorianMezzo.Pages.HealthCheck"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:FlorianMezzo.Controls">
    <ScrollView>
        <Grid BackgroundColor="{StaticResource Tertiary}">
            <!--  Main content  -->
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>


            <VerticalStackLayout
                Grid.Row="0"
                Padding="0,0,0,30"
                BackgroundColor="Black"
                Spacing="25">

                <Border
                    x:Name="header"
                    Margin="0"
                    Padding="0">
                    <!--  Main Navigation Bar  -->
                    <ScrollView HorizontalOptions="FillAndExpand" Orientation="Horizontal">
                        <Border
                            x:Name="navBar"
                            Padding="0,20,0,20"
                            BackgroundColor="{StaticResource Tertiary}"
                            HorizontalOptions="FillAndExpand">
                            <StackLayout
                                HorizontalOptions="Center"
                                Orientation="Horizontal"
                                Spacing="40">
                                <Label
                                    FontSize="44"
                                    SemanticProperties.HeadingLevel="Level2"
                                    Style="{StaticResource Headline}"
                                    Text="Home"
                                    TextColor="{StaticResource PrimaryDark}"
                                    VerticalOptions="Start">
                                    <Label.GestureRecognizers>
                                        <TapGestureRecognizer NumberOfTapsRequired="1" Tapped="redirectToMain" />
                                    </Label.GestureRecognizers>
                                </Label>
                                <Button
                                    x:Name="CompatibilityNav"
                                    Clicked="redirectToCompatibility"
                                    MaximumWidthRequest="1000"
                                    SemanticProperties.Hint="Redirects User to Tile Tester Page"
                                    Text="Compatibility Tool"
                                    TextColor="{StaticResource Primary}"
                                    WidthRequest="270" />
                                <Button
                                    x:Name="healthCheckNav"
                                    Clicked="redirectToHealthCheck"
                                    MaximumWidthRequest="1000"
                                    SemanticProperties.Hint="Redirects User to Health Check Page"
                                    Text="Health Check"
                                    TextColor="White"
                                    WidthRequest="270" />

                                <!--
                                <Button
                                    x:Name="mezzoAnalysisNav"
                                    Text="Mezzo Analysis"
                                    TextColor="{StaticResource Primary}"
                                    SemanticProperties.Hint="Redirects User to Mezzo Analysis Page"
                                    Clicked="redirectToMezzoAnalysis"
                                    WidthRequest="270"
                                    MaximumWidthRequest="1000" />
                                <Button
                                    x:Name="more3AMNav"
                                    Text="More 3AM"
                                    TextColor="{StaticResource Primary}"
                                    SemanticProperties.Hint="Redirects User to More 3AM Page"
                                    Clicked="redirectToMore3AM"
                                    WidthRequest="270"
                                    MaximumWidthRequest="1000" />
                                -->
                            </StackLayout>
                        </Border>
                    </ScrollView>
                </Border>


                <VerticalStackLayout
                    x:Name="content"
                    MaximumWidthRequest="1300"
                    Spacing="10">

                    <Label
                        FontSize="32"
                        LineBreakMode="WordWrap"
                        SemanticProperties.HeadingLevel="Level2"
                        Style="{StaticResource SubHeadline}"
                        Text="Statuses of all requirements for FLORIAN are listed below. Ensure all statuses are Online before downloading FLORIAN. Click on any status to expand its components. "
                        VerticalOptions="Start" />
                    <Border
                        Margin="0,10"
                        HeightRequest="2"
                        Stroke="White"
                        StrokeThickness="1" />

                    <!--  Service bar  -->
                    <VerticalStackLayout HorizontalOptions="Fill" Spacing="10">
                        <Grid ColumnDefinitions="*,Auto,*">

                            <VerticalStackLayout Grid.Column="0" HorizontalOptions="FillAndExpand">
                                <Label
                                    x:Name="fetchCountLabel"
                                    FontSize="32"
                                    LineBreakMode="WordWrap"
                                    SemanticProperties.HeadingLevel="Level2"
                                    Style="{StaticResource Headline}"
                                    Text="Fetch Count"
                                    VerticalOptions="Center" />
                                <Label
                                    x:Name="fetchCountNum"
                                    FontSize="32"
                                    LineBreakMode="WordWrap"
                                    SemanticProperties.HeadingLevel="Level2"
                                    Style="{StaticResource Headline}"
                                    Text="0"
                                    VerticalOptions="Center" />
                            </VerticalStackLayout>
                            <Border
                                x:Name="serviceStatus"
                                Grid.Column="1"
                                Margin="10"
                                Padding="10"
                                BackgroundColor="#F94620"
                                HeightRequest="65"
                                HorizontalOptions="Center"
                                VerticalOptions="Center"
                                WidthRequest="65">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="5" />
                                </Border.StrokeShape>

                                <Image
                                    x:Name="serviceStatusImage"
                                    HeightRequest="40"
                                    HorizontalOptions="Center"
                                    Source="xmark.png"
                                    VerticalOptions="Center"
                                    WidthRequest="40" />
                            </Border>
                            <VerticalStackLayout Grid.Column="2" HorizontalOptions="FillAndExpand">
                                <Label
                                    x:Name="intervalLabel"
                                    FontSize="32"
                                    LineBreakMode="WordWrap"
                                    SemanticProperties.HeadingLevel="Level2"
                                    Style="{StaticResource Headline}"
                                    Text="Interval"
                                    VerticalOptions="Center" />
                                <HorizontalStackLayout HorizontalOptions="Center">
                                    <Label
                                        x:Name="intervalHrNum"
                                        FontSize="32"
                                        LineBreakMode="WordWrap"
                                        SemanticProperties.HeadingLevel="Level2"
                                        Style="{StaticResource Headline}"
                                        Text=""
                                        VerticalOptions="Center" />
                                    <Label
                                        x:Name="intervalCollin1"
                                        FontSize="32"
                                        LineBreakMode="WordWrap"
                                        SemanticProperties.HeadingLevel="Level2"
                                        Style="{StaticResource Headline}"
                                        Text=":"
                                        VerticalOptions="Center" />
                                    <Label
                                        x:Name="intervalMinNum"
                                        FontSize="32"
                                        LineBreakMode="WordWrap"
                                        SemanticProperties.HeadingLevel="Level2"
                                        Style="{StaticResource Headline}"
                                        Text=""
                                        VerticalOptions="Center" />
                                    <Label
                                        x:Name="intervalCollin2"
                                        FontSize="32"
                                        LineBreakMode="WordWrap"
                                        SemanticProperties.HeadingLevel="Level2"
                                        Style="{StaticResource Headline}"
                                        Text=":"
                                        VerticalOptions="Center" />
                                    <Label
                                        x:Name="intervalSecNum"
                                        FontSize="32"
                                        LineBreakMode="WordWrap"
                                        SemanticProperties.HeadingLevel="Level2"
                                        Style="{StaticResource Headline}"
                                        Text=""
                                        VerticalOptions="Center" />
                                </HorizontalStackLayout>
                            </VerticalStackLayout>
                        </Grid>

                        <Button
                            x:Name="toggleServiceBtn"
                            BorderColor="White"
                            BorderWidth="2"
                            Clicked="ToggleService"
                            HorizontalOptions="FillAndExpand"
                            SemanticProperties.Hint="Stops the Health Checker Service"
                            Text="Start Service" />
                    </VerticalStackLayout>

                    <VerticalStackLayout
                        x:Name="esdStack"
                        Padding="0,10"
                        Spacing="10">
                        <controls:ExpandableStateDisplay x:Name="tileSoftDependencyESD" />
                        <controls:ExpandableStateDisplay x:Name="coreSoftDependencyESD" />
                        <controls:ExpandableStateDisplay x:Name="resourceESD" />
                        <controls:StateDisplay x:Name="florianSD" />

                        <Button
                            x:Name="redirectToFlorianSettingsBtn"
                            BorderColor="White"
                            BorderWidth="2"
                            Clicked="redirectToFlorianSettings"
                            HorizontalOptions="FillAndExpand"
                            SemanticProperties.Hint="Redirect to FLORIAN Permissions"
                            Text="Set FLORIAN Permissions" />
                        <Button
                            x:Name="ExportBtn"
                            Margin="0,20,0,0"
                            BorderColor="White"
                            BorderWidth="2"
                            Clicked="ExportToCSV"
                            HorizontalOptions="Center"
                            MaximumWidthRequest="600"
                            SemanticProperties.Hint="Exports the health checker as a csv file"
                            Text="Export Health Check" />

                    </VerticalStackLayout>

                </VerticalStackLayout>
            </VerticalStackLayout>

            <!--  Footer  -->
			<Border
                x:Name="footer"
                Grid.Row="1"
                Padding="0,20"
                BackgroundColor="Transparent">
				<Grid HorizontalOptions="FillAndExpand" VerticalOptions="End">
					<Grid.ColumnDefinitions>
						<ColumnDefinition Width="Auto" />
						<ColumnDefinition Width="*" />
						<ColumnDefinition Width="Auto" />
					</Grid.ColumnDefinitions>
					<Label Grid.Column="0"></Label>
					<Label Grid.Column="1"></Label>
					<Image
                        Aspect="AspectFit"
						Grid.Column="2"
                        HeightRequest="80"
                        HorizontalOptions="End"
                        SemanticProperties.Description="3AM Logo"
                        Source="i3am_gold.png"
                        VerticalOptions="Center" />
				</Grid>
			</Border>
		</Grid>
	</ScrollView>
</ContentPage>
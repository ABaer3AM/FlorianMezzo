<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="FlorianMezzo.Pages.Compatibility"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:FlorianMezzo.Controls"
    x:Name="CompatibilityPage">
    <ScrollView>
        <Grid BackgroundColor="{StaticResource Tertiary}">
            <!--  Main content  -->
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>


            <VerticalStackLayout
                Grid.Row="0"
                Padding="0,0,0,30"
                BackgroundColor="Black"
                Spacing="25">

                <Border
                    x:Name="header"
                    Margin="0"
                    Padding="0">
                    <!--  Main Navigation Bar  -->
                    <ScrollView HorizontalOptions="FillAndExpand" Orientation="Horizontal">
                        <Border
                            x:Name="navBar"
                            Padding="0,20,0,20"
                            BackgroundColor="{StaticResource Tertiary}"
                            HorizontalOptions="FillAndExpand">
                            <StackLayout
                                HorizontalOptions="Center"
                                Orientation="Horizontal"
                                Spacing="40">
                                <Label
                                    FontSize="44"
                                    SemanticProperties.HeadingLevel="Level2"
                                    Style="{StaticResource Headline}"
                                    Text="Home"
                                    TextColor="{StaticResource PrimaryDark}"
                                    VerticalOptions="Start">
                                    <Label.GestureRecognizers>
                                        <TapGestureRecognizer NumberOfTapsRequired="1" Tapped="redirectToMain" />
                                    </Label.GestureRecognizers>
                                </Label>
                                <Button
                                    x:Name="CompatibilityNav"
                                    Clicked="redirectToCompatibility"
                                    MaximumWidthRequest="1000"
                                    SemanticProperties.Hint="Redirects User to Tile Tester Page"
                                    Text="Compatibility Tool"
                                    TextColor="White"
                                    WidthRequest="270" />
                                <Button
                                    x:Name="healthCheckNav"
                                    Clicked="redirectToHealthCheck"
                                    MaximumWidthRequest="1000"
                                    SemanticProperties.Hint="Redirects User to Health Check Page"
                                    Text="Health Check"
                                    TextColor="{StaticResource Primary}"
                                    WidthRequest="270" />

                                <!--
                                <Button
                                    x:Name="mezzoAnalysisNav"
                                    Text="Mezzo Analysis"
                                    TextColor="{StaticResource Primary}"
                                    SemanticProperties.Hint="Redirects User to Mezzo Analysis Page"
                                    Clicked="redirectToMezzoAnalysis"
                                    WidthRequest="270"
                                    MaximumWidthRequest="1000" />
                                <Button
                                    x:Name="more3AMNav"
                                    Text="More 3AM"
                                    TextColor="{StaticResource Primary}"
                                    SemanticProperties.Hint="Redirects User to More 3AM Page"
                                    Clicked="redirectToMore3AM"
                                    WidthRequest="270"
                                    MaximumWidthRequest="1000" />
                                -->
                            </StackLayout>
                        </Border>
                    </ScrollView>
                </Border>



                <VerticalStackLayout
                    x:Name="content"
                    MaximumWidthRequest="1300"
                    Spacing="10">

                    <Label
                        FontSize="32"
                        LineBreakMode="WordWrap"
                        SemanticProperties.HeadingLevel="Level2"
                        Style="{StaticResource SubHeadline}"
                        Text="Statuses of all requirements for FLORIAN are listed below. Ensure all statuses are Online before downloading FLORIAN. Click on any status to expand its components. "
                        VerticalOptions="Start" />
                    <Border
                        Margin="0,10"
                        HeightRequest="2"
                        Stroke="White"
                        StrokeThickness="1" />

                    <Button
                        x:Name="getStatusesBtn"
                        BorderColor="White"
                        BorderWidth="2"
                        Clicked="GetStatuses"
                        HorizontalOptions="FillAndExpand"
                        SemanticProperties.Hint="Starts a process to fetch all statuses needed for FLORIAN install"
                        Text="Get Statuses" />

                    <VerticalStackLayout
                        x:Name="esdStack"
                        Padding="0,10"
                        Spacing="10">
                        <controls:ExpandableStateDisplay x:Name="tileSoftDependencyESD" />
                        <controls:ExpandableStateDisplay x:Name="coreSoftDependencyESD" />
                        <controls:ExpandableStateDisplay x:Name="resourceESD" />
                        <controls:StateDisplay x:Name="florianSD" />



                    </VerticalStackLayout>

                    <Button
                        x:Name="mStoreNav"
                        BorderColor="White"
                        BorderWidth="2"
                        Clicked="OpenFlorianInStore"
                        HorizontalOptions="Center"
                        SemanticProperties.Hint="Redirects user to the microsfot store"
                        Text="Download FLORIAN" />

                </VerticalStackLayout>
            </VerticalStackLayout>



            <!--  Footer  -->
            <Border
                x:Name="footer"
                Grid.Row="1"
                Padding="0,20"
                BackgroundColor="Transparent"
                HorizontalOptions="End">
                <HorizontalStackLayout HorizontalOptions="EndAndExpand" VerticalOptions="End">
                    <Label
                        FontSize="44"
                        SemanticProperties.HeadingLevel="Level2"
                        Style="{StaticResource Headline}"
                        Text="Mezzo"
                        TextColor="{StaticResource PrimaryDark}"
                        VerticalOptions="Start" />
                    <Image
                        Aspect="AspectFit"
                        HeightRequest="80"
                        HorizontalOptions="End"
                        SemanticProperties.Description="3AM Logo"
                        Source="i3am_gold.png"
                        VerticalOptions="Center" />
                </HorizontalStackLayout>
            </Border>

        </Grid>
    </ScrollView>
</ContentPage>
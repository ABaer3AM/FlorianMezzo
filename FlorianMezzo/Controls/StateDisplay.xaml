<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="FlorianMezzo.Controls.StateDisplay">
    <VerticalStackLayout
        BackgroundColor="Transparent"
        Margin="0"
        Padding="0">
        <!-- Main Control -->
        <Border 
            x:Name="sdFrame"
            Margin="0,0,0,0"
            BackgroundColor="#3E3E3C"
            Stroke="Transparent"
            Padding="0"
            ZIndex="1">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="5"/>
            </Border.StrokeShape>
            
            <Grid>
                <!-- Define two columns: Text on the left, Image on the right -->
                <Grid.ColumnDefinitions>
                    <!-- Expands to take up remaining space -->
                    <ColumnDefinition Width="*" />
                    <!-- Shrinks to fit the content -->
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Dropdown Indicator -->
                <Image 
                    x:Name="dropdownMarker"
                    Grid.Column="0"
                    Source="greater_than.png" 
                    HeightRequest="30" 
                    WidthRequest="30"
                    Margin="15,0,0,0"
                    VerticalOptions="Center" 
                    HorizontalOptions="Start" />

                <!-- Text on the left (Title) -->
                <Label 
                    x:Name="titleText"
                    Grid.Column="0"
                    VerticalOptions="Center" 
                    Margin="55,0,0,0"
                    HorizontalOptions="Start"
                    Style="{StaticResource SubHeadline}" />

                <!-- Text to the right (feedback) -->
                <Label 
                    x:Name="feedbackText"
                    Grid.Column="0"
                    VerticalOptions="Center" 
                    HorizontalOptions="EndAndExpand"
                    Margin="0,0,5,0"
                    Style="{StaticResource MinorHeadline}" />

                <!-- Frame with Image on the right -->
                <Border
                    Grid.Column="1"
                    x:Name="imageFrame"
                    HeightRequest="65" 
                    WidthRequest="65" 
                    BackgroundColor="#F94620" 
                    Padding="10"
                    VerticalOptions="Center"
                    HorizontalOptions="Center"
                    Margin="10">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="5"/>
                    </Border.StrokeShape>

                    <Image 
                        x:Name="statusImage"
                        Source="xmark.png" 
                        HeightRequest="40" 
                        WidthRequest="40" 
                        VerticalOptions="Center" 
                        HorizontalOptions="Center" />
                </Border>
            </Grid>
            <Border.GestureRecognizers>
                <TapGestureRecognizer
                    x:Name="noteGesture"
                    Tapped="ShowNote" />
            </Border.GestureRecognizers>
        </Border>
        
        <!-- Dropdown Note -->
        <Border
            x:Name="DropdownNote"
            IsVisible="False" 
            Margin="30, -20, 30, 20"
            BackgroundColor="#1a1a1a"
            Padding="20, 40, 20, 20"
            ZIndex="0">
            <!-- label HERE -->
            <Label 
                x:Name="noteText"
                VerticalOptions="StartAndExpand" 
                HorizontalOptions="StartAndExpand"
                Margin="0,0,5,0"
                HorizontalTextAlignment="Start"
                Style="{StaticResource MinorHeadline}" />
        </Border>
    </VerticalStackLayout>
</ContentView>
